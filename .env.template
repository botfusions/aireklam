# Botfusions AI Reklam Ajansı — Çevresel Değişkenler
# Bu dosyayı .env olarak kopyalayıp gerçek değerleri doldurun.
# .env dosyası ASLA repoya commitlenmez (.gitignore'da).

# ── OmniSocials ──
OMNISOCIALS_API_KEY=omsk_live_xxxxx

# ── Supabase ──
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_KEY=eyJxxx

# ── Google OAuth (GA4 + GSC) ──
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_ADS_DEVELOPER_TOKEN=xxxx
GOOGLE_ADS_CUSTOMER_ID=1234567890

# ── Google OAuth Refresh Tokens ──
GSC_REFRESH_TOKEN=1//xxxx
GA4_REFRESH_TOKEN=1//xxxx

# ── WaveSpeed AI ──
WAVESPEED_API_KEY=xxxx

# ── NocoDB ──
NOCODB_API_TOKEN=xxxx

# ── CMO Dashboard API ──
CMO_SERVER_PORT=8765
CMO_API_KEY=local-dev-secret-key-buraya-yazin
