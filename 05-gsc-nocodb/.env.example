# GSC → NocoDB Pipeline — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyala ve değerleri doldur:
#   cp .env.example .env

# ── Google Search Console ──────────────────────────
# Service Account JSON dosyasının tam yolu
GSC_CREDENTIALS_PATH=/path/to/gsc-service-account.json

# Varsayılan site URL (--client parametresi bunu override eder)
# GSC_SITE_URL=https://botfusions.com

# ── NocoDB ─────────────────────────────────────────
# NocoDB sunucu adresi (VPS 2: botfusions.com)
NOCODB_BASE_URL=https://nocodb.turklawai.com

# NocoDB API token (Admin Panel → Team & Auth → API Token)
NOCODB_API_TOKEN=your_nocodb_token_here
